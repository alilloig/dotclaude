# ── Plugin runtime (keep config, ignore downloaded cache/repos) ──
# installed_plugins.json is machine-derived state (absolute installPaths,
# lastUpdated churn); setup.sh is the declarative plugin manifest.
plugins/installed_plugins.json
plugins/cache/
plugins/data/
plugins/marketplaces/
plugins/known_marketplaces.json
plugins/install-counts-cache.json
plugins/plugin-catalog-cache.json
plugins/plugin-directory-cache*.json
plugins/blocklist.json
plugins/.last_inuse_sweep
plugins/.trash/
plugins/synced/

# Skills downloaded by Claude's sync service (keep authored skills tracked)
skills/synced/

# ── Channels (bot tokens, access control — NEVER commit) ──
channels/

# ── OAuth / API credentials (NEVER commit) ──
.credentials.json

# ── Settings backups (auto-generated) ──
settings.json.backup.*

# ── Cleanup hook marker (regenerated each run) ──
.last-cleanup

# ── Background daemon + job state (recreated by the harness each run) ──
daemon/
daemon.lock
daemon.log
daemon.status.json
daemon-auth-*
jobs/
gh-pr-status-cache.json*
remote-settings.json
policy-limits.json

# ── Retired sui-pilot symlink (hook removed 2026-07-10; stale sessions may
# still recreate it — keep ignored so it never gets tracked by accident) ──
/sui-pilot

# ── EVM/Solidity-security auditor skill repos (regenerable clones) ──
# Cloned by scripts/setup-sol-sec-stack.sh; they're independent git repos,
# re-fetched on demand — never commit them into dotclaude.
skills-src/

# ── OS junk ──
.DS_Store
__pycache__/
worktrees/

# ── Skill eval-loop workspaces (iteration artifacts, never shipped) ──
skills/*-workspace/
